---
import PageLayout from '../layouts/PageLayout.astro';

const { REPOSITORY_URL } = process.env;
---

<PageLayout title="404: Not found">
  <p>I recently migrated my blog to a new platform and may have broken a few links inadvertently!</p>
  {REPOSITORY_URL && (
    <p>
      If you don't mind, please <a href={`${REPOSITORY_URL}/issues/new?title=404%20Not%20Found&labels=bug`}>log an issue</a> with the URL you were trying to reach and where you found the URL. Thank you!
    </p>
  )}
  <p>
    In the meantime, you can <a href="/">head back home</a> to try finding it again.
  </p>
</PageLayout>
