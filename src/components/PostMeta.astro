---
import FontAwesomeSymbol from './FontAwesomeSymbol.astro';
import { siteMetadata } from '../data/siteMetadata';
import { formatDate, type Post } from '../utils/posts';
import { postUrl } from '../utils/urls';
import { slug } from '../utils/slugify';

type Props = {
  post: Post;
};

const { post } = Astro.props;
const { date, categories, tags } = post.data;
const url = postUrl(post.id);

const { REPOSITORY_URL, BRANCH } = process.env;
---

<div class="post-meta">
  <span class="posted-on">
    <FontAwesomeSymbol symbolName="icon-calendar" />
    <span class="screen-reader-text">Posted on </span>
    <a href={url} rel="bookmark">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </a>
  </span>

  {categories.length > 0 && (
    <span class="categories">
      <FontAwesomeSymbol symbolName="icon-folder" />
      <span class="screen-reader-text">Categories </span>
      {categories.map((category, index) => (
        <>
          {index > 0 && ', '}
          <a href={`/category/${slug(category)}/`} rel="category tag">
            {category}
          </a>
        </>
      ))}
    </span>
  )}

  {tags.length > 0 && (
    <span class="tags">
      <FontAwesomeSymbol symbolName="icon-tags" />
      <span class="screen-reader-text">Tags </span>
      {tags.map((tag, index) => (
        <>
          {index > 0 && ', '}
          <a href={`/tag/${slug(tag)}/`} rel="tag">
            {tag}
          </a>
        </>
      ))}
    </span>
  )}

  <span class="comments">
    <FontAwesomeSymbol symbolName="icon-comment" />
    <a href={`${url}#disqus_thread`}>
      <span class="disqus-comment-count" data-disqus-identifier="" data-disqus-url={new URL(url, siteMetadata.siteUrl).href} data-disqus-shortname={siteMetadata.disqusShortname}>
        Comments
      </span>
    </a>
  </span>

  {REPOSITORY_URL && BRANCH && (
    <span class="edit">
      <FontAwesomeSymbol symbolName="icon-edit" />
      <a href={`${REPOSITORY_URL}/edit/${BRANCH}/src/content/posts/${post.id}.md`}>Edit</a>
    </span>
  )}
</div>

<script>
  // Disqus replaces the text of every `.disqus-comment-count` element with that post's comment count.
  const commentCount = document.querySelector<HTMLElement>('.disqus-comment-count');

  // Astro bundles this script once per page, however many posts are listed.
  if (commentCount) {
    const script = document.createElement('script');
    script.src = `https://${commentCount.dataset.disqusShortname}.disqus.com/count.js`;
    script.async = true;
    document.body.appendChild(script);
  }
</script>
