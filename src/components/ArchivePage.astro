---
import PageLayout from '../layouts/PageLayout.astro';
import { formatDate, type Post } from '../utils/posts';
import { postUrl } from '../utils/urls';

type Props = {
  title: string;
  posts: Post[];
};

const { title, posts } = Astro.props;

// Years stay in descending order because posts are sorted newest first
const postsGroupedByYear = Map.groupBy(posts, (post) => post.data.date.getUTCFullYear());
---

<PageLayout title={title}>
  {[...postsGroupedByYear].map(([year, yearPosts]) => (
    <>
      <h2>{year}</h2>
      <ul>
        {yearPosts.map((post) => (
          <li>
            <h3 class="post-entry">
              <a href={postUrl(post.id)} data-astro-prefetch>
                {post.data.title} <small>{formatDate(post.data.date)}</small>
              </a>
            </h3>
          </li>
        ))}
      </ul>
    </>
  ))}
</PageLayout>
