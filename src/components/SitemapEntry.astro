---
import type { SitemapEntry } from '../data/sitemap';

type Props = SitemapEntry;

const { title, url, sub } = Astro.props;
---

<li>
  {url ? (
    <a href={url} data-astro-prefetch>
      {title}
    </a>
  ) : (
    title
  )}
  {sub && (
    <ul>
      {sub.map((entry) => (
        <Astro.self {...entry} />
      ))}
    </ul>
  )}
</li>
