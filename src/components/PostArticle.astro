---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import PostMeta from './PostMeta.astro';
import { getPostUrl, type Post } from '../utils/posts';

type Props = {
  post: Post;
  linkTitle?: boolean;
};

const { post, linkTitle } = Astro.props;
const { title, image } = post.data;
const { Content } = await render(post);
---

<article id={`post-${post.id}`} class="post">
  <header class="post-header">
    <h1 class="post-title">
      {linkTitle ? (
        <a href={getPostUrl(post)} rel="bookmark">
          {title}
        </a>
      ) : (
        title
      )}
    </h1>
  </header>

  {image && (
    <div class="post-thumbnail">
      <Image class="sidebar-logo" src={image} alt={title} />
    </div>
  )}

  <PostMeta post={post} />

  <div class="post-content">
    <Content />
  </div>
</article>
