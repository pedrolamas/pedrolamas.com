---
import { getImage } from 'astro:assets';

import { siteMetadata } from '../data/siteMetadata';
import { getAppIcons } from '../utils/appIcons';

export type HeadProps = {
  type: 'index' | 'page' | 'post';
  title?: string;
  description?: string;
  imageUrl?: string;
  categories?: string[];
  tags?: string[];
  date?: Date;
  lastModified?: Date;
};

type Props = HeadProps;

const props = Astro.props;
const { siteUrl, description, author, authorDetails, title, lang, logo, twitter, facebook } = siteMetadata;

const siteLogoUrl = new URL((await getImage({ src: logo, format: 'jpg' })).src, siteUrl).href;
const authorPictureUrl = new URL((await getImage({ src: authorDetails.picture, format: 'jpg' })).src, siteUrl).href;
const favicon = await getImage({ src: logo, width: 32, height: 32, format: 'png' });
const appleTouchIcons = await getAppIcons();

const pageTitle = props.title || title;
const pageDescription = props.description || description;
const pageImageUrl = (props.imageUrl && new URL(props.imageUrl, siteUrl).href) || siteLogoUrl;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const date = props.date?.toISOString();
const lastModified = props.lastModified?.toISOString();

const jsonLd = {
  '@context': 'http://schema.org',
  '@type': props.type === 'index' ? 'WebSite' : props.type === 'page' ? 'WebPage' : 'BlogPosting',
  name: title,
  headline: pageTitle,
  description: pageDescription,
  publisher: {
    '@type': 'Organization',
    name: title,
    logo: siteLogoUrl,
  },
  author: {
    '@type': 'Person',
    name: author,
    image: authorPictureUrl,
  },
  image: pageImageUrl,
  datePublished: date,
  dateModified: lastModified || date,
  url: pageUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': siteUrl,
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
<meta name="generator" content={Astro.generator} />
<title>{props.title ? `${props.title} – ${title}` : `${title} – ${description}`}</title>

{pageDescription && <meta name="description" content={pageDescription} />}
<meta name="author" content={author} />

<link rel="canonical" href={pageUrl} />

<meta property="og:type" content={props.type === 'index' ? 'website' : 'article'} />
<meta property="og:site_name" content={title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:url" content={pageUrl} />
{pageDescription && <meta property="og:description" content={pageDescription} />}
<meta property="og:image" content={pageImageUrl} />
<meta property="og:locale" content={lang.replace('-', '_')} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
<meta property="fb:admins" content={facebook.admins} />
<meta property="fb:app_id" content={facebook.appId} />
{props.type !== 'index' && (
  <>
    <meta property="article:publisher" content={facebook.publisher} />
    {date && <meta property="article:published_time" content={date} />}
    {lastModified && <meta property="article:modified_time" content={lastModified} />}
    {props.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
  </>
)}

<meta name="twitter:url" content={pageUrl} />
<meta name="twitter:card" content={props.imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content={`@${twitter.username}`} />
<meta name="twitter:creator" content={`@${authorDetails.twitter || twitter.username}`} />
<meta name="twitter:title" content={pageTitle} />
{pageDescription && <meta name="twitter:description" content={pageDescription} />}
<meta name="twitter:image" content={pageImageUrl} />
<meta name="twitter:label1" content="Written by" />
<meta name="twitter:data1" content={author} />
{props.categories && props.categories.length > 0 && (
  <>
    <meta name="twitter:label2" content="Filed under" />
    <meta name="twitter:data2" content={props.categories.join(', ')} />
  </>
)}

<meta name="theme-color" content="#202020" />
<link rel="icon" href={favicon.src} type="image/png" />
<link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />
{appleTouchIcons.map(({ size, src }) => (
  <link rel="apple-touch-icon" sizes={`${size}x${size}`} href={src} />
))}
<link rel="alternate" type="application/rss+xml" href="/feed.xml" />
<link rel="alternate" type="application/json" href="/feed.json" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
