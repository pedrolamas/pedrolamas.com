{
  "name": "pedrolamas.com",
  "private": true,
  "type": "module",
  "description": "Programming and Tinkering",
  "version": "0.1.0",
  "author": "Pedro Lamas <pedrolamas@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "prepare": "husky || true",
    "lint": "pnpm lint:code && pnpm lint:other",
    "lint:code": "eslint .",
    "lint:other": "prettier --check .",
    "format": "pnpm format:code && pnpm format:other",
    "format:code": "eslint . --fix",
    "format:other": "prettier --write ."
  },
  "lint-staged": {
    "*.{json,md,markdown,css,scss,yaml,yml}": [
      "prettier --check"
    ],
    "*.{ts,js,mjs,astro}": [
      "eslint",
      "prettier --check"
    ]
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/pt-sans": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@shikijs/themes": "^4.6.0",
    "astro": "^7.4.11",
    "sass": "^1.108.2",
    "satteri": "0.11.7"
  },
  "bugs": {
    "url": "https://github.com/pedrolamas/pedrolamas.com/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.5.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrolamas/pedrolamas.com"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
